<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, so builds don't depend on sources configured on a developer's machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
