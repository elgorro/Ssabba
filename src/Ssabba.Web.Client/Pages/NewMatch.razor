@page "/matches/new"
@using Microsoft.AspNetCore.Authorization
@using Ssabba.Shared
@using Ssabba.Web.Client.Components
@using System.Net.Http.Json
@attribute [Authorize]
@rendermode InteractiveAuto
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Record a match</PageTitle>

<h1>Record a match</h1>

@if (teams is null)
{
    <p><em>Loading teams…</em></p>
}
else if (teams.Count < 2)
{
    <p>
        At least two teams are needed before a match can be recorded.
        <a href="teams/new">Form one</a>.
    </p>
}
else
{
    <MatchForm Model="model" FormName="new-match" Teams="teams" OnValidSubmit="Save">
        <button type="submit" class="btn btn-primary btn-lg" disabled="@saving">Save match</button>
        <a class="btn btn-secondary" href="matches">Cancel</a>

        @if (error is not null)
        {
            <p class="text-danger mt-3">@error</p>
        }
    </MatchForm>
}

@code {
    private readonly MatchForm.MatchFormModel model = new();
    private List<TeamSummary>? teams;
    private bool saving;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        teams = await Http.GetFromJsonAsync<List<TeamSummary>>(ApiRoutes.Teams) ?? [];
    }

    private async Task Save()
    {
        saving = true;
        error = null;

        var request = new CreateMatchRequest(
            new DateTimeOffset(model.PlayedAt, TimeSpan.Zero),
            // No court picker yet, so the typed location stays free text.
            null,
            model.Location,
            model.HomeTeamId,
            model.AwayTeamId,
            model.Scores());

        var response = await Http.PostAsJsonAsync(ApiRoutes.Matches, request);

        saving = false;

        if (!response.IsSuccessStatusCode)
        {
            error = await MatchForm.Explain(response);

            return;
        }

        Navigation.NavigateTo("matches");
    }
}
