{
  "uid": "ssabba-overview",
  "title": "Ssabba overview",
  "tags": ["ssabba"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({service=\"web\"} [$__auto]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errors (last 6h)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"web\", level=~\"Error|Fatal\"} [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Traefik requests",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"traefik\"} [$__auto]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Application log",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service=\"web\"}", "refId": "A" }]
    }
  ]
}
