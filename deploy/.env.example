# Copy to .env and adjust. Never commit the result.

# Public hostname Traefik serves; also used to build OIDC redirect URIs.
APP_DOMAIN=ssabba.example.com
# Address Let's Encrypt notifies about expiring certificates.
ACME_EMAIL=admin@example.com

# PostgreSQL 18
POSTGRES_DB=ssabba
POSTGRES_USER=ssabba
POSTGRES_PASSWORD=change-me
# Separate database on the same server for Keycloak.
KEYCLOAK_DB=keycloak

# Keycloak initial admin (change the password after the first login)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Client secret shared between Keycloak's ssabba-web client and the app.
OIDC_CLIENT_SECRET=change-me
# Set to false only for local runs with a self-signed certificate.
OIDC_REQUIRE_HTTPS_METADATA=true

# API key shared by CrowdSec's LAPI and the Traefik bouncer plugin.
# Generate: docker compose exec crowdsec cscli bouncers add traefik
CROWDSEC_LAPI_KEY=change-me

GRAFANA_ADMIN_PASSWORD=change-me

# Container image coordinates
GITHUB_OWNER=your-github-user
SSABBA_VERSION=latest

# Host ports used by the development override (deploy/compose.override.yaml).
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432
WEB_PORT=5080
DOCS_PORT=1313
GRAFANA_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
